<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier: nothing is included in a backup (allowBackup="false" already turns it off; this keeps
     it off if that flag is ever changed). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
