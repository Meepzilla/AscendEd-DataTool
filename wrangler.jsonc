// Cloudflare hosting for the installable web app: publishes the static build (npm run build:static) in out/.
// worker/index.js runs first on every request: it redirects plain HTTP to HTTPS and otherwise hands the request
// to the static files, served as they are with the headers in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ascended-datatool",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
